#!/usr/bin/env bash
# Deliverable Adaptive-HISA speed config (post redundancy + chunk64).
# Source this file before launching the server / bench_one_batch.
export SGLANG_NSA_ADAPTIVE_HISA_MODE=adaptive_decode
export SGLANG_NSA_ADAPTIVE_HISA_PARTITION_METRIC=key_sse
export SGLANG_NSA_ADAPTIVE_HISA_MERGE_POLICY=sync_nonoverlap
export SGLANG_NSA_ADAPTIVE_HISA_SUMMARY_COMPRESSION=32
export SGLANG_NSA_ADAPTIVE_HISA_MERGE_TARGET_DIVISOR=128
export SGLANG_NSA_ADAPTIVE_HISA_MERGE_TARGET_ROUNDS=4
export SGLANG_NSA_ADAPTIVE_HISA_DECODE_CHUNK=64
export SGLANG_NSA_ADAPTIVE_HISA_CANDIDATE_TOKENS=8192
export SGLANG_NSA_ADAPTIVE_HISA_BUILD_SUMMARIES=1
export SGLANG_NSA_ADAPTIVE_HISA_SKIP_CLEAN=1
export SGLANG_NSA_ADAPTIVE_HISA_FUSE_PAGE_TABLE=1
export SGLANG_NSA_ADAPTIVE_HISA_RAW_FP8_BUILDER=1
export SGLANG_NSA_ADAPTIVE_HISA_DECODE_TIMING=1
export SGLANG_NSA_FUSE_TOPK=0
# Optional (enable after bit-exact interval check):
# export SGLANG_NSA_ADAPTIVE_HISA_SEGMENT_SCORER=1
