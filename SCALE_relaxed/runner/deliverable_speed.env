#!/usr/bin/env bash
# Relaxed λ-DP (S32/M128) measured on 8xH20, 128K in / 128 out, TP8, CUDA Graph BS=1.
# TTFT 38.92 s, E2E 41.11 s, TPOT 17.20 ms. Quality-unqualified speed point.
export SGLANG_NSA_FUSE_TOPK=0
export SGLANG_NSA_PER_HEAD_INDEX=0
export SGLANG_NSA_EXPERIMENTAL_PREFILL_PER_HEAD=0
export SGLANG_JIT_DEEPGEMM_PRECOMPILE=0
export SGLANG_NSA_ADAPTIVE_HISA_MODE=adaptive_decode
export SGLANG_NSA_ADAPTIVE_HISA_PARTITION_METRIC=key_sse
export SGLANG_NSA_ADAPTIVE_HISA_SPLIT_BACKEND=gpu
export SGLANG_NSA_ADAPTIVE_HISA_BUILD_SUMMARIES=1
export SGLANG_NSA_ADAPTIVE_HISA_MERGE_POLICY=sync_nonoverlap
export SGLANG_NSA_ADAPTIVE_HISA_SUMMARY_COMPRESSION=32
export SGLANG_NSA_ADAPTIVE_HISA_MERGE_TARGET_DIVISOR=128
export SGLANG_NSA_ADAPTIVE_HISA_MERGE_TARGET_ROUNDS=1
export SGLANG_NSA_ADAPTIVE_HISA_MAX_MERGE_LEN=0
export SGLANG_NSA_ADAPTIVE_HISA_GRAPH_BUILD=1
export SGLANG_NSA_ADAPTIVE_HISA_GPU_STREAM=side
export SGLANG_NSA_ADAPTIVE_HISA_FALLBACK_LAYERS=0
export SGLANG_NSA_ADAPTIVE_HISA_SINK_TOKENS=64
export SGLANG_NSA_ADAPTIVE_HISA_TAIL_TOKENS=256
export SGLANG_NSA_ADAPTIVE_HISA_CANDIDATE_TOKENS=8192
export SGLANG_NSA_ADAPTIVE_HISA_DECODE_CHUNK=64
export SGLANG_NSA_ADAPTIVE_HISA_SKIP_CLEAN=1
export SGLANG_NSA_ADAPTIVE_HISA_FUSE_PAGE_TABLE=1
export SGLANG_NSA_ADAPTIVE_HISA_RAW_FP8_BUILDER=1
export SGLANG_NSA_ADAPTIVE_HISA_DECODE_TIMING=0
export SGLANG_NSA_ADAPTIVE_HISA_SELECTOR_PROFILE=0
export SGLANG_NSA_ADAPTIVE_HISA_PARTITION_VALIDATE=0
export SGLANG_NSA_ADAPTIVE_HISA_FORWARD_TIMING=0
export SGLANG_NSA_ADAPTIVE_HISA_SPARSE_PREFILL=1
export SGLANG_NSA_ADAPTIVE_HISA_SPARSE_PREFILL_DENSE_FINAL=0
export SGLANG_NSA_ADAPTIVE_HISA_SPARSE_PREFILL_ROWS=8192
export SGLANG_NSA_ADAPTIVE_HISA_PREFILL_SELECT=weighted
export SGLANG_NSA_ADAPTIVE_HISA_TREE_CACHE=1
export SGLANG_NSA_ADAPTIVE_HISA_ROOT_LOCAL_PARTITION=0
export SGLANG_NSA_ADAPTIVE_HISA_ROOT_LOCAL_FUSED_SUMMARIES=0
export SGLANG_NSA_ADAPTIVE_HISA_RELAXED_SPLIT=1
export SGLANG_NSA_ADAPTIVE_HISA_SOFT_MERGE_ROUNDS=2
export SGLANG_NSA_ADAPTIVE_HISA_LAMBDA_MAX_ROUNDS=2
export SGLANG_NSA_ADAPTIVE_HISA_MERGE_ALPHA=2.0
