+        check_tensor_equal(
+            idx,
+            "nsa_cu_seqlens_k",
+            fused["nsa_cu_seqlens_k"][: bs + 1],
+            ref["nsa_cu_seqlens_k"][: bs + 1],
+        )
+
+        if precomputed.real_page_table is not None:
+            rows, cols = precomputed.real_page_table.shape
+            check_tensor_equal(
+                idx,
+                "real_page_table",
+                fused["real_page_table"][:rows, :cols],
+                ref["real_page_table"][:rows, :cols],
+            )
+
