-  __shared__ uint64_t sel[kMaxKeys];
-  __shared__ bool any;
-  if (threadIdx.x == 0) {
-    for (int j = 0; j < kMaxKeys; ++j) sel[j] = static_cast<uint64_t>(state[kStateSel + j]);
