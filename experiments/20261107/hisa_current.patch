+        ref_results.append(
+            {
+                "cache_seqlens": ref_cache_seqlens,
+                "cu_seqlens_k": ref_cu_seqlens_k,
+                "page_table_1": ref_page_table_1,
+                "nsa_cache_seqlens": ref_nsa_cache_seqlens,
+                "nsa_cu_seqlens_k": ref_nsa_cu_seqlens_k,
