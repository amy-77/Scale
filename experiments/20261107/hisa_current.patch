-def _bottleneck(
-    gain: torch.Tensor,
-    tiebreak: torch.Tensor,
-    frontier: torch.Tensor,
-    layout: TreeLayout,
-) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
-    """Reachability and bottleneck key of every splittable node below ``frontier``."""
