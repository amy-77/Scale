-// thr_out[0] = successor of k-th smallest (k clamped to [1, n]); -inf if k <= 0.
-void kth_threshold_f64(
-    const at::Tensor& values, const at::Tensor& k, at::Tensor& thr_out, at::Tensor& scratch) {
