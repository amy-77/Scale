-  TORCH_CHECK(k.is_cuda() && k.scalar_type() == at::kLong && k.numel() == 1);
-  TORCH_CHECK(thr_out.is_cuda() && thr_out.scalar_type() == at::kDouble && thr_out.numel() == 1);
