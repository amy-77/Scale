-    """Threshold admitting the ``admit * (count - target)`` cheapest eligible edges."""
-    deficit = merge_deficit(count, target, cost.shape[0])
-    return kth_cost_threshold(cost, (deficit * int(admit)).clamp_max(cost.shape[0]))
