+            ref["cache_seqlens"],
+        )
+        check_tensor_equal(
+            idx,
+            "cu_seqlens_k",
+            fused["cu_seqlens_k"],
+            ref["cu_seqlens_k"],
+        )
+        # Multi-backend is DECODE mode only, so compare only [:, :max_len]
+        check_tensor_equal(
+            idx,
+            "page_table_1",
+            fused["page_table_1"][:, : precomputed.max_len],
