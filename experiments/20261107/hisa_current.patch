-                row_batch,
-                row_len,
-                _offline_router.budget(),
-                pooling_block_size=_offline_router.misa_chunk_size(),
-                prune_topk=_offline_router.misa_prune_topk(),
-                prune_keep_fraction=_offline_router.misa_prune_keep_fraction(),
-                return_metadata=True,
