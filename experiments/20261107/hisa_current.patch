+    # Compare results for all 3 backends
+    def check_tensor_equal(backend_idx, name, fused, ref):
+        if not torch.equal(fused, ref):
+            max_diff = (fused.float() - ref.float()).abs().max().item()
+            mismatched_elements = (fused != ref).sum().item()
