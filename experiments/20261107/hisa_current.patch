+        ref_cu_seqlens_k[1:].copy_(precomputed.cu_seqlens_k[1:])
+        ref_page_table_1[:, : precomputed.max_len].copy_(precomputed.page_indices)
+        ref_nsa_cache_seqlens.copy_(precomputed.nsa_cache_seqlens)
