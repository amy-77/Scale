+            check_tensor_equal(
+                idx,
+                "flashmla_num_splits",
+                fused["flashmla_num_splits"][: bs + 1],
+                ref["flashmla_num_splits"][: bs + 1],
+            )
+            check_tensor_equal(
+                idx,
+                "flashmla_metadata",
+                fused["flashmla_metadata"],
+                ref["flashmla_metadata"],
+            )
